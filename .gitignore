# Secrets / generated locally by setup.sh / setup.ps1 — never commit these
panel/router_key
panel/router_key.pub
panel/.env
# the panel's own HTTPS certificate + private key (tls.go makes them on first run)
panel/panel_cert.pem
panel/panel_key.pem
# local test copies of the panel binary and keys
/gui/

# Go build output
panel/cpe-box
panel/cpe-box.exe
panel/panel
panel/dist/
router/sms-reader/dist/
router/sms-reader-arm

# Runtime state — fetch.sh writes the currently-downloaded release tag here
panel/.release
router/sms-reader/dist/
# motion map floor plan (your own, local)
/data/

# Local backups you may have made of your router
backups/
*.bin

# OS noise
.DS_Store
Thumbs.db

# Personal Claude Code permission overrides (not team-shared)
.claude/settings.local.json
